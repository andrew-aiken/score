[Unit]
Description=Score Server
Wants=network-online.target
After=network-online.target ntp.service nats.service

[Service]
PrivateTmp=true
Type=simple
ExecStart=/usr/local/bin/score server --nats-creds /home/nats/.local/share/nats/nsc/keys/creds/score/score/server.creds start --config /home/nats/config.json --log-level info
Restart=on-failure
RestartSec=5
User=nats
Group=nats

[Install]
WantedBy=multi-user.target
