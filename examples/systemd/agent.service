[Unit]
Description=Scoring Agent
Wants=network-online.target
After=network-online.target ntp.service

[Service]
PrivateTmp=true
Type=simple
ExecStart=/usr/local/bin/score agent --nats-creds /home/nats/agent.creds --teams 0 --log-level info
Restart=on-failure
RestartSec=5
User=nats
Group=nats

[Install]
WantedBy=multi-user.target
